PORT=4000
DATABASE_URL=postgres://linkwave:linkwave_dev_password@127.0.0.1:5432/linkwavehub
JWT_SECRET=linkwavehub-dev-jwt-secret-change-me
ENCRYPTION_KEY=linkwavehub-32-byte-key-change!!
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
DEFAULT_CURRENCY=GHS

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → Web OAuth client)
# Live redirect URI (production always uses this): https://linkboost-growth.onrender.com/api/auth/google/callback
# On Render set FRONTEND_URL=https://linkboost-growth.onrender.com. Do not use localhost there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Forgot password emails (optional). Without SMTP, reset links are logged by the API in development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Linkwave SMM <support@linkwavehub.com>

# Hosted Postgres / Supabase (Project Settings → Database → URI)
# Keep ENCRYPTION_KEY the same if you copy local provider API keys.
# LIVE_DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Korapay (Dashboard → Settings → API Keys). Never commit live or test secret keys.
# KORAPAY_PUBLIC_KEY=pk_test_xxxxxxxx
# KORAPAY_SECRET_KEY=sk_test_xxxxxxxx
# KORAPAY_ENCRYPTION_KEY=
